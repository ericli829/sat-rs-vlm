PROJECT_ROOT=/root/autodl-tmp/sat-rs-vlm
DATA_ROOT=/root/autodl-tmp/datasets
MODEL_ROOT=/root/autodl-tmp/models
QWEN3VL_4B_MODEL_DIR=/root/autodl-tmp/models/Qwen3-VL-4B-Instruct
OUTPUT_ROOT=/root/autodl-tmp/outputs
REPLAY_ADAPTER_DIR=/root/autodl-tmp/outputs/checkpoints/lora/replay_generalist
QWEN3VL_4B_REPLAY_ADAPTER_DIR=/root/autodl-tmp/outputs/checkpoints/lora/qwen3vl_4b/replay_generalist
CACHE_ROOT=/root/autodl-tmp/cache
TMPDIR=/root/autodl-tmp/temp
TENSORBOARD_ROOT=/root/tf-logs
BACKUP_ROOT=/root/autodl-fs/experiments
HF_HOME=/root/autodl-tmp/cache/huggingface
HF_HUB_CACHE=/root/autodl-tmp/cache/huggingface/hub
TORCH_HOME=/root/autodl-tmp/cache/torch
PIP_CACHE_DIR=/root/autodl-tmp/cache/pip
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1

# GeoRSCLIP weights must already exist; bootstrap installs packages only.
GEORSCLIP_CHECKPOINT=/root/autodl-fs/rs_detectors/georsclip/GeoRSCLIP-ViT-B-32.pt

# LAE-DINO assets are local inputs to the isolated rs-vlm-lae environment.
LAE_DINO_ENV_NAME=rs-vlm-lae
LAE_DINO_SOURCE_ROOT=/root/autodl-fs/rs_detectors/lae_dino/source/LAE-DINO
LAE_DINO_REQUIREMENTS=/root/autodl-fs/rs_detectors/lae_dino/source/LAE-DINO/mmdetection_lae/requirements.txt
LAE_DINO_CONFIG=/root/autodl-fs/rs_detectors/lae_dino/source/LAE-DINO/mmdetection_lae/configs/lae_dino/exact_checkpoint_config.py
LAE_DINO_CHECKPOINT=/root/autodl-fs/rs_detectors/lae_dino/checkpoints/exact_checkpoint.pth
LAE_DINO_BERT_ROOT=/root/autodl-fs/rs_detectors/lae_dino/weights/bert-base-uncased
