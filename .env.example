PROJECT_ROOT=/path/to/sat-rs-vlm
DATA_ROOT=/path/to/datasets
MODEL_ROOT=/path/to/models
OUTPUT_ROOT=./outputs
CACHE_ROOT=./.cache
TMPDIR=./.tmp
TENSORBOARD_ROOT=./outputs/tensorboard
BACKUP_ROOT=./outputs/backups
